@using VehicleInsuranceProject.ViewModels;
@model CustomerDetailsViewModel;

@{
    ViewData["Title"] = "Customer Details";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Adjust the layout if needed
}

<h2 class="text-center">Customer Details</h2>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text"><strong>Email:</strong> @Model.Email</p>
        <p class="card-text"><strong>Phone:</strong> @Model.Phone</p>
        <p class="card-text"><strong>Address:</strong> @Model.Address</p>
    </div>
</div>

<div class="text-center mt-3">
    <a asp-controller="Customer" asp-action="UpdateProfile" class="btn btn-secondary">Edit</a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Home</a>
</div>