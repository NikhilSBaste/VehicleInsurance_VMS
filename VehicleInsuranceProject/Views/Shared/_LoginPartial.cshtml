@using Microsoft.AspNetCore.Identity;
@using VehicleInsuranceProject.Repository.Models
@inject SignInManager<IdentityUser> signInManager;

<ul class="navbar-nav ms-auto">
    @if (signInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Customer" asp-action="Details">Details</a>
        </li>

        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Customer" asp-action="Logout">Logout</a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Customer" asp-action="Login">Login</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Customer" asp-action="Register">Register</a>
        </li>
    }
</ul>