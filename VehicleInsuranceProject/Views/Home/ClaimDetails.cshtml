@using System.Security.Claims
@model List<VehicleInsuranceProject.Repository.ClaimTable>
@{
    ViewData["Title"] = "Claim Details";
}
<div class="text-center">
    <h1 class="display-4">Claim Details</h1>
</div>

<table class="table table-striped">

    <tr><th>Claim ID</th>
    <th>Claim Amount</th>
    <th>Claim Reason</th>
    <th>Claim Date</th>
    <th>Claim Status</th>
    </tr>
	<tbody>
	@foreach (var claim in Model)
	{
		<tr>
			<td>@claim.claimId</td>
			<td>@claim.claimAmount</td>
			<td>@claim.claimReason</td>
			<td>@claim.claimDate.ToString("yyyy-MM-dd")</td>
			<td>@claim.claimStatus</td>
		</tr>
	}
	</tbody>

	

</table>
@* <a asp-action="UpdateStatus" asp-route-id="@.claimId" class="btn btn-warning">Update Status</a> *@