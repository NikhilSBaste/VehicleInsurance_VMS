@model VehicleInsuranceProject.Repository.ClaimTable

@{
	ViewData["Title"] = "Claim Form"; //By this we can pass the data to other pages or files
}
<div class="text-center">
	Claim Form
</div>
<form class="form-control align-content-center" asp-controller="Home" asp-action="AddClaim">
	
	@* <label class="mt-4">Claim ID</label> *@
	@* <input type="number" class="form-control" placeholder="0" asp-for="claimId" /> *@
	<label class="mt-4">Claim Amount</label>
	<input type="number" class="form-control" placeholder="0" asp-for="claimAmount" />
	<label class="mt-4">Claim Reason</label>
	<input type="text" class="form-control" placeholder="0" asp-for="claimReason" />
	<label class="mt-4">Claim Date</label>
	<input type="date" class="form-control" placeholder="0" asp-for="claimDate" />
	<label class="mt-4">Claim Status</label>
	<select class="form-control" asp-for="claimStatus">
		<option value="Pending">Pending</option>
		<option value="Approved">Approved</option>
		<option value="Rejected">Rejected</option>
	</select>

	<button class="btn btn-primary mt-4" type="submit">Submit</button>
</form>